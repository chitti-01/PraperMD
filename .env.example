# ============================================================
# PaperMD — Production Environment Variables Configuration
# ============================================================

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key for browser-safe operations (Public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase Service Role Key (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PaperMD Admin Secret Key (STRICTLY SERVER-SIDE)
ADMIN_SECRET_KEY=your_admin_secret_passkey_here
